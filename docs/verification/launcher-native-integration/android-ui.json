  "visual_review": {
    "result": "All20 original PNG captures reviewed",
    "shared_shell": "Correct Start/Wallet/Messaging pages with native system bars and bottom commands separated. Lower Start row and next Wallet pivot heading are intentionally clipped scrolling surfaces.",
    "home": "Actual HOME Start/Wallet/HOME-key return/Back-at-Start captures retain the inset-safe layout. Native role output and JSON independently establish authority; HOME captures precede carrier-role selection and retain separate local sample badges.",
    "notification_bootstrap": "Cold Start shows canonical Messaging badge1. Initial list capture shows local groups with the shell fixture below the viewport. One native swipe reveals the exact nonce title and body; after listener revocation the native groups/fixture disappear and local sample groups remain.",
    "native_calls": "Ringing includes the native incoming heads-up notification over CallActivity. Active caller5550102 and native controls are readable; ended shows call ended. The app-native answer button is identified in the UIAutomator tree and tapped; hangup uses remote-end emulator gsm cancel rather than End-call input.",
    "root_review": {
      "files": [
        "device-action-center.png",
        "device-action-center-revoked.png",
        "device-start-unread.png",
        "home-role-back-start.png",
        "device-active-call.png",
        "device-messaging.png"
      ],
      "result": "Root independently reviewed these six originals and matching notification JSON: exact nonce title/body readable, revoked native rows absent, canonical unread badge1 visible, HOME retained Start, sender5550101/full nonce SMS visible, and active caller5550102/controls unclipped."
    },
    "capture_modification": "None. Original files and SHA-256 values retained."
  },
